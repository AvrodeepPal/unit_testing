    {
      "id": "kx43us1rs",
      "node_id": "node-credit-health-report-a51e5e2c",
      "version_tag": "v1",
      "title": "Credit Health Report",
      "description": {
        "text": {
          "text": "Constructs a prompt for credit scoring with internal component scoring for credit health scorecard.\n\nThis node builds a prompt for an LLM to compute a Credit Health Score using a provided scorecard. It parses the user profile (employment, income, dependents, CIBIL) and a matched behavioral record that contains proxy metrics (e.g., FOIR, utilization, DPD). The prompt includes a distortion detection mechanism: if the proxy’s FOIR exceeds 70% or utilization exceeds 80%, it adds a 50% penalty scaling note. The LLM is instructed to compute all 11 components internally (maximum total 100) but NEVER reveal the breakdown in the output. The final output must follow a strict template: a numeric score, a category, a two‑line summary, three positive factors, three negative factors, two improvement actions, and a lender verdict. This design protects proprietary scoring logic while delivering actionable insights.",
          "lineHeight": 14,
          "fontSize": 11,
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
        },
        "lineHeight": 14,
        "fontSize": 11,
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
      },
      "metadata": {
        "node_id": "node-credit-health-report-a51e5e2c",
        "name": "Credit Health Report",
        "description": "Constructs a prompt for credit scoring with internal component scoring for credit health scorecard.\n\nThis node builds a prompt for an LLM to compute a Credit Health Score using a provided scorecard. It parses the user profile (employment, income, dependents, CIBIL) and a matched behavioral record that contains proxy metrics (e.g., FOIR, utilization, DPD). The prompt includes a distortion detection mechanism: if the proxy’s FOIR exceeds 70% or utilization exceeds 80%, it adds a 50% penalty scaling note. The LLM is instructed to compute all 11 components internally (maximum total 100) but NEVER reveal the breakdown in the output. The final output must follow a strict template: a numeric score, a category, a two‑line summary, three positive factors, three negative factors, two improvement actions, and a lender verdict. This design protects proprietary scoring logic while delivering actionable insights.",
        "category": "finance",
        "owner_id": "105973339426953711978",
