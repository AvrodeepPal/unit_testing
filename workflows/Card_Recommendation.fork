    {
      "id": "i9rjo6rse",
      "node_id": "node-card-recommendation-0a9a1c00",
      "version_tag": "v1",
      "title": "Card Recommendation",
      "description": {
        "text": {
          "text": {
            "text": "Merges user profile, lifestyle, and shortlisted cards into a forensic ranking prompt for top 3 cards.\n\nThis node prepares a final prompt for ranking credit cards after an initial shortlist has been generated. It extracts card IDs from the shortlisted cards output, retrieves full technical specifications from a vector catalog, and also fetches wildcard cards that match the user’s lifestyle preferences (e.g., reward preference, travel frequency, fuel usage, fee tolerance). The node then builds a comprehensive prompt that includes eligibility locks (income and CIBIL checks), an existing‑card filter, a net annual value calculation, and lifestyle‑based optimization. The LLM is instructed to output exactly three cards in a structured format with reasons and estimated value. This ensures that the final recommendation is data‑driven, personalized, and free of markdown or extra commentary.",
            "lineHeight": 14,
            "fontSize": 11,
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
          },
          "lineHeight": 14,
          "fontSize": 11,
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
        },
        "lineHeight": 14,
        "fontSize": 11,
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
      },
      "metadata": {
        "node_id": "node-card-recommendation-0a9a1c00",
        "name": "Card Recommendation",
        "description": "Merges user profile, lifestyle, and shortlisted cards into a forensic ranking prompt for top 3 cards.\n\nThis node prepares a final prompt for ranking credit cards after an initial shortlist has been generated. It extracts card IDs from the shortlisted cards output, retrieves full technical specifications from a vector catalog, and also fetches wildcard cards that match the user’s lifestyle preferences (e.g., reward preference, travel frequency, fuel usage, fee tolerance). The node then builds a comprehensive prompt that includes eligibility locks (income and CIBIL checks), an existing‑card filter, a net annual value calculation, and lifestyle‑based optimization. The LLM is instructed to output exactly three cards in a structured format with reasons and estimated value. This ensures that the final recommendation is data‑driven, personalized, and free of markdown or extra commentary.",
        "category": "finance",
        "owner_id": "105973339426953711978",
