    {
      "id": "o6fn3w1g6",
      "node_id": "node-card-catalog-fb710069",
      "version_tag": "v1",
      "title": "Card Catalog",
      "description": {
        "text": {
          "text": {
            "text": {
              "text": {
                "text": {
                  "text": {
                    "text": {
                      "text": "Queries a vector database to retrieve eligible credit cards and builds a prompt for LLM shortlisting.\n\nThis node creates a prompt that asks an LLM to shortlist the 10 best credit cards for a user based on their profile. It first parses the user’s employment, income, CIBIL, spend tier, and preferred spending categories from a pipe‑separated string. It then normalizes the CIBIL into a bucket (excellent, very_good, good, fair, poor, very_poor) and constructs a retrieval query that includes these eligibility dimensions. The vector database returns up to 25 candidate card records, which are then fed into a strict prompt template. The LLM must apply hard eligibility rules (income and CIBIL thresholds) and smart matching rules (spending behavior, category fit, value optimization). The output is a bullet‑list of exactly ten cards with their IDs, names, and one‑line reasons - no additional explanation or formatting. This node acts as the first‑stage filter before detailed ranking.",
                      "lineHeight": 14,
                      "fontSize": 11,
                      "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
                    },
                    "lineHeight": 14,
                    "fontSize": 11,
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
                  },
                  "lineHeight": 14,
                  "fontSize": 11,
                  "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
                },
                "lineHeight": 14,
                "fontSize": 11,
                "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
              },
              "lineHeight": 14,
              "fontSize": 11,
              "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
            },
            "lineHeight": 14,
            "fontSize": 11,
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
          },
          "lineHeight": 14,
          "fontSize": 11,
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
        },
        "lineHeight": 14,
        "fontSize": 11,
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
      },
      "metadata": {
        "node_id": "node-card-catalog-fb710069",
        "name": "Card Catalog",
        "description": "Queries a vector database to retrieve eligible credit cards and builds a prompt for LLM shortlisting.\n\nThis node creates a prompt that asks an LLM to shortlist the 10 best credit cards for a user based on their profile. It first parses the user’s employment, income, CIBIL, spend tier, and preferred spending categories from a pipe‑separated string. It then normalizes the CIBIL into a bucket (excellent, very_good, good, fair, poor, very_poor) and constructs a retrieval query that includes these eligibility dimensions. The vector database returns up to 25 candidate card records, which are then fed into a strict prompt template. The LLM must apply hard eligibility rules (income and CIBIL thresholds) and smart matching rules (spending behavior, category fit, value optimization). The output is a bullet‑list of exactly ten cards with their IDs, names, and one‑line reasons - no additional explanation or formatting. This node acts as the first‑stage filter before detailed ranking.",
        "category": "llm",
        "owner_id": "105973339426953711978",
