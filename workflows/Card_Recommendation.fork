    {
      "id": "vej796289",
      "node_id": "node-user-profile-input-(card-recommendation)-889ef8c7",
      "version_tag": "v1",
      "title": "User Profile Input (Card Recommendation)",
      "description": {
        "text": {
          "text": {
            "text": {
              "text": {
                "text": {
                  "text": {
                    "text": {
                      "text": "Validates seven financial inputs and returns a pipe‑delimited profile string for credit card eligibility.\n\nThis node accepts manual user inputs from a financial eligibility screen and transforms them into a standardized pipe‑separated string for downstream processing. It takes seven parameters: employment type, monthly income, monthly card spend, three top spending categories, and CIBIL score. The node first validates that all inputs are present and non‑empty. It then concatenates the three spending categories into a single comma‑separated string. Using the validated values, it builds a string following the format Employment: <value> | Income: <value> | CardSpend: <value> | Categories: <value> | Cibil: <value>. This structured output allows downstream nodes (e.g., eligibility checkers, card catalog retrievers) to parse the profile reliably without re‑validating the inputs. No extra prefixes or metadata are added - the raw profile string is returned directly.",
                      "lineHeight": 14,
                      "fontSize": 11,
                      "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
                    },
                    "lineHeight": 14,
                    "fontSize": 11,
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
                  },
                  "lineHeight": 14,
                  "fontSize": 11,
                  "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
                },
                "lineHeight": 14,
                "fontSize": 11,
                "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
              },
              "lineHeight": 14,
              "fontSize": 11,
              "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
            },
            "lineHeight": 14,
            "fontSize": 11,
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
          },
