    {
      "id": "nuvi8my4z",
      "node_id": "node-vae-decode-(sdxl)-9fd8a18c",
      "version_tag": "v1",
      "title": "VAE Decode (SDXL)",
      "description": {
        "text": {
          "text": {
            "text": {
              "text": {
                "text": {
                  "text": {
                    "text": {
                      "text": "This node converts latent representations from a Stable Diffusion XL pipeline back into full-resolution RGB images using the VAE decoder. The VAE model is already preloaded by the wrapper, so the node focuses on preparing inputs and performing efficient decoding.\n\nIt begins by aligning the latent tensor with the VAE’s device and datatype, then applies the inverse of the SDXL latent scaling factor to restore the correct value range. The latents are passed through the VAE decoder under autocast (mixed precision) for optimized performance on compatible hardware.\n\nFinally, the decoded output is normalized from the latent range [-1, 1] to a standard [0, 1] image range. The result is a ready-to-use image tensor that can be displayed, saved, or further processed.",
                      "lineHeight": 14,
                      "fontSize": 11,
                      "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
                    },
                    "lineHeight": 14,
                    "fontSize": 11,
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
                  },
                  "lineHeight": 14,
                  "fontSize": 11,
                  "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
                },
                "lineHeight": 14,
                "fontSize": 11,
                "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
              },
              "lineHeight": 14,
              "fontSize": 11,
              "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
            },
            "lineHeight": 14,
            "fontSize": 11,
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
          },
          "lineHeight": 14,
          "fontSize": 11,
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
        },
        "lineHeight": 14,
        "fontSize": 11,
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
      },
      "metadata": {
        "node_id": "node-vae-decode-(sdxl)-9fd8a18c",
        "name": "VAE Decode (SDXL)",
        "description": "This node converts latent representations from a Stable Diffusion XL pipeline back into full-resolution RGB images using the VAE decoder. The VAE model is already preloaded by the wrapper, so the node focuses on preparing inputs and performing efficient decoding.\n\nIt begins by aligning the latent tensor with the VAE’s device and datatype, then applies the inverse of the SDXL latent scaling factor to restore the correct value range. The latents are passed through the VAE decoder under autocast (mixed precision) for optimized performance on compatible hardware.\n\nFinally, the decoded output is normalized from the latent range [-1, 1] to a standard [0, 1] image range. The result is a ready-to-use image tensor that can be displayed, saved, or further processed.",
        "category": "image_sdxl",
        "owner_id": "112361794260852586879",
        "visibility": "public",
        "organization_id": 1,
