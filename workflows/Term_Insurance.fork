    {
      "id": "0oltgd37q",
      "node_id": "node-accept-term-profile-c3e18352",
      "version_tag": "v1",
      "title": "Accept Term Profile",
      "description": {
        "text": {
          "text": {
            "text": {
              "text": {
                "text": "Formats term life insurance eligibility inputs into a pipe‑delimited profile string.\n\nThis node maps raw user inputs for term life insurance into a standardized pipe‑separated string. It takes twelve parameters including age, gender, tobacco usage, marital status, dependents count, annual income, desired sum assured (in crores), policy term (in years), and boolean preferences for return of premium, critical illness rider, and retirement planning. The node automatically sets the SeniorCitizen flag to True if the age is 60 or older. All inputs are used as provided (without validation) and assembled into a format like Age: <value> | Gender: <value> | TobaccoUser: <value> | .... This clean, parseable output enables downstream nodes to reliably extract user attributes for term insurance policy filtering and scoring.",
                "lineHeight": 14,
                "fontSize": 11,
                "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
              },
              "lineHeight": 14,
              "fontSize": 11,
              "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
            },
            "lineHeight": 14,
            "fontSize": 11,
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
          },
          "lineHeight": 14,
          "fontSize": 11,
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
        },
        "lineHeight": 14,
        "fontSize": 11,
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
      },
